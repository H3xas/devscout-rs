<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
    <RootNamespace>ScoutSemantic</RootNamespace>
    <AssemblyName>scout-semantic</AssemblyName>
    <EnableDefaultItems>true</EnableDefaultItems>
    <!-- The fact document reports this as its producer version, so the
         informational version has to stay exactly the declared number: without
         the second property the SDK appends "+<commit sha>" to it. -->
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn 4.14.0 is the newest 4.14.x line and the one that ships with the
         9.0.3xx SDK / VS 17.14; Workspaces.MSBuild carries the out-of-process
         BuildHost that evaluates the target solution's MSBuild files. -->
    <PackageReference Include="Microsoft.Build.Locator" Version="1.9.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.14.0" />
    <!-- Pinned to the version Workspaces.MSBuild already resolves transitively,
         with ExcludeAssets="runtime" so neither DLL is copied to the output
         directory: an in-process Microsoft.Build.Evaluation.ProjectCollection
         (ContextInventory.cs, never the ambient one the workspace uses) must
         resolve its assemblies through MSBuildLocator's redirect to the
         installed SDK at run time, not a locally-copied NuGet build. Without
         this, evaluation binds an older in-process assembly against the
         installed SDK's newer targets files and throws on an intrinsic
         function the older assembly does not implement. -->
    <PackageReference Include="Microsoft.Build" Version="17.7.2" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.7.2" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="scout-semantic.Tests" />
  </ItemGroup>

</Project>
