<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Current 9.0.x patch on NuGet as of 2026-09-03, matching net9.0 TFM. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.19" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.19" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.19" />
    <!-- Current 2.9.x xunit; xunit.runner.visualstudio has no 2.9.x line, so current 2.8.x. -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Current 17.x Microsoft.NET.Test.Sdk (18.x exists but is out of the requested 17.x line). -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>
</Project>
