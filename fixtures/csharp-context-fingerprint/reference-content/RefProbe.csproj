<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Which of the two committed, differently-built DLLs is referenced is
         chosen by the caller (-p:ExtLibPath=...); the project itself never
         changes between the pair's two runs. -->
    <Reference Include="ExtLib">
      <HintPath>$(ExtLibPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
