<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile check for the syntax catalogue fixture. Every construct file in this directory
    must build under SDK 9 with the preview language level; the Rust pin test copies only
    the .cs files, so this project never reaches the graph.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
